# Apply to the Bridge server process, not to a model prompt or phone payload.
LINEJS_ALLOW_CALLS=1
LINEJS_VOICE_WORKER=/absolute/path/to/linejs-voice/worker.mjs
LINEJS_NODE=/absolute/path/to/node
LINEJS_DATA_DIR=/absolute/path/to/existing/encrypted/session-directory
# macOS: use the existing authorized helper that can read this session's key.
LINEJS_KEYCHAIN_HELPER=/absolute/path/to/existing/keychain-helper
# Linux: systemd should provision the 32-byte binary key as a private credential
# named linejs-master-key; CREDENTIALS_DIRECTORY is supplied by systemd.
# Optional server-side STUN/TURN configuration; keep TURN credentials private.
# LINEJS_ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]}]
