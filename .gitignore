/everything-go
/dist/
/build/

# Local recovery snapshots created during executor experiments.
*.backup-record2-*

# Private FCM credentials are provisioned at runtime, never compiled or shipped.
cmd/everything-go/keys/*.json
fcm_service_account.json
serviceAccountKey.json
internal/core/notification_reply_secret
/release-artifacts/
*.log
.DS_Store

# Runtime state written into --data-dir when the bridge is run from the source
# tree (default data-dir is cwd). The real service writes to ~/.everything-go-runtime.
everything_go_sessions.json
everything_go_search.db
everything_go_search.db-shm
everything_go_search.db-wal
pairing.json
fcm_token.txt
/feed/
/inbox/

# Private state from a local --data-dir=. run must not become source history.
/*.db
/*.db-*
/*.sqlite
/*.sqlite-*
/*_secret
/instance_id
/fcm_tokens.json
/session_runtime.json
/goal_snapshots.json
/codex_maintenance.json
/codex-turn-requests/
/session-recaps/
/monitoring_env.sh
.env
.env.*
