{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bridge:task-api:1.0.0-rc.3",
  "$defs": {
    "ArtifactInput": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "seal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "artifact_id": {
          "const": "result.txt"
        },
        "expected_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        }
      },
      "required": [
        "task_id",
        "seal_id",
        "artifact_id",
        "expected_hash",
        "offset",
        "limit"
      ],
      "additionalProperties": false
    },
    "ArtifactBytes": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "seal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "artifact_id": {
          "const": "result.txt"
        },
        "owner_request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "next_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "has_more": {
          "type": "boolean"
        },
        "full_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "chunk_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "data_base64": {
          "type": "string",
          "maxLength": 43692
        }
      },
      "required": [
        "task_id",
        "seal_id",
        "artifact_id",
        "owner_request_id",
        "total_bytes",
        "offset",
        "next_offset",
        "has_more",
        "full_hash",
        "chunk_hash",
        "data_base64"
      ],
      "additionalProperties": false
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "api_versions": {
          "type": "array",
          "items": {
            "const": "1.0.0-rc.3"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "schema_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "allowed_operations": {
          "type": "array",
          "items": {
            "enum": [
              "artifact_capabilities",
              "read_artifact_bytes"
            ]
          },
          "minItems": 2,
          "maxItems": 2
        },
        "mutation_authority_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "max_range_bytes": {
          "const": 32768
        },
        "artifact_owner": {
          "const": "immutable_sealed_final"
        },
        "reported_paths": {
          "const": "unsupported"
        }
      },
      "required": [
        "api_versions",
        "schema_hash",
        "allowed_operations",
        "mutation_authority_instance_id",
        "max_range_bytes",
        "artifact_owner",
        "reported_paths"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "acceptance": {
          "enum": [
            "known_none",
            "unknown"
          ]
        },
        "recommended_action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "retryable": {
          "const": false
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "code",
        "acceptance",
        "recommended_action",
        "retryable",
        "message"
      ],
      "additionalProperties": false
    },
    "Request_artifact_capabilities": {
      "type": "object",
      "properties": {
        "type": {
          "const": "task_api_request"
        },
        "api_version": {
          "const": "1.0.0-rc.3"
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "operation": {
          "const": "artifact_capabilities"
        },
        "input": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "api_version",
        "correlation_id",
        "operation",
        "input"
      ],
      "additionalProperties": false
    },
    "Request_read_artifact_bytes": {
      "type": "object",
      "properties": {
        "type": {
          "const": "task_api_request"
        },
        "api_version": {
          "const": "1.0.0-rc.3"
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "operation": {
          "const": "read_artifact_bytes"
        },
        "input": {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "seal_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "artifact_id": {
              "const": "result.txt"
            },
            "expected_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32768
            }
          },
          "required": [
            "task_id",
            "seal_id",
            "artifact_id",
            "expected_hash",
            "offset",
            "limit"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "api_version",
        "correlation_id",
        "operation",
        "input"
      ],
      "additionalProperties": false
    },
    "Request": {
      "oneOf": [
        {
          "$ref": "#/$defs/Request_artifact_capabilities"
        },
        {
          "$ref": "#/$defs/Request_read_artifact_bytes"
        }
      ]
    },
    "Response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "task_api_response"
            },
            "api_version": {
              "const": "1.0.0-rc.3"
            },
            "correlation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "operation": {
              "const": "artifact_capabilities"
            },
            "ok": {
              "const": true
            },
            "result": {
              "$ref": "#/$defs/Capabilities"
            }
          },
          "required": [
            "type",
            "api_version",
            "correlation_id",
            "operation",
            "ok",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "task_api_response"
            },
            "api_version": {
              "const": "1.0.0-rc.3"
            },
            "correlation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "operation": {
              "const": "read_artifact_bytes"
            },
            "ok": {
              "const": true
            },
            "result": {
              "$ref": "#/$defs/ArtifactBytes"
            }
          },
          "required": [
            "type",
            "api_version",
            "correlation_id",
            "operation",
            "ok",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "task_api_response"
            },
            "api_version": {
              "const": "1.0.0-rc.3"
            },
            "correlation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "operation": {
              "enum": [
                "artifact_capabilities",
                "read_artifact_bytes"
              ]
            },
            "ok": {
              "const": false
            },
            "error": {
              "$ref": "#/$defs/Error"
            },
            "request_api_version": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "api_version",
            "correlation_id",
            "operation",
            "ok",
            "error",
            "request_api_version"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
