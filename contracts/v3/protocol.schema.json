{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://averything.local/contracts/v3/protocol.schema.json",
  "title": "Averything Bridge protocol v3 semantic model",
  "type": "object",
  "required": [
    "protocol_version",
    "identity",
    "runtime",
    "payload_versions",
    "compatibility",
    "event_types",
    "command_types"
  ],
  "properties": {
    "protocol_version": {
      "const": 3
    },
    "identity": {
      "type": "object",
      "required": [
        "session_key_prefix",
        "session_key_components",
        "authority_field"
      ],
      "properties": {
        "session_key_prefix": {
          "const": "sk1:"
        },
        "session_key_components": {
          "const": [
            "authority_instance_id",
            "session_id"
          ]
        },
        "authority_field": {
          "const": "authority_instance_id"
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "phases",
        "stages",
        "terminal_phases"
      ],
      "properties": {
        "phases": {
          "$ref": "#/$defs/runtimePhases"
        },
        "stages": {
          "$ref": "#/$defs/runtimeStages"
        },
        "terminal_phases": {
          "const": [
            "completed",
            "failed",
            "interrupted",
            "closed"
          ]
        }
      },
      "additionalProperties": false
    },
    "payload_versions": {
      "type": "object",
      "required": [
        "runtime",
        "work",
        "external_event",
        "attachment",
        "fcm"
      ],
      "properties": {
        "runtime": {
          "const": 3
        },
        "work": {
          "const": 3
        },
        "external_event": {
          "const": 3
        },
        "attachment": {
          "const": 3
        },
        "fcm": {
          "const": 3
        }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": [
        "additive",
        "deprecated",
        "breaking"
      ],
      "properties": {
        "additive": {
          "const": "optional fields only; old readers must ignore them"
        },
        "deprecated": {
          "const": "supported for at least one published mobile version"
        },
        "breaking": {
          "const": "requires a new protocol_version and explicit negotiation"
        }
      },
      "additionalProperties": false
    },
